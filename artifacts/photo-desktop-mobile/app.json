{
  "expo": {
    "name": "Photo Desktop Mobile",
    "slug": "photo-desktop-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/photo-desktop-icon.png",
    "scheme": "photo-desktop-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/photo-desktop-icon.png"
    },
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
